{
  "name": "guardium-supported-datasources",
  "homepage": ".",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@carbon/ibm-security": "^2.11.1",
    "@carbon/react": "^1.64.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.16.8",
    "@mui/material": "^5.16.8",
    "carbon-components": "^10.53.0",
    "export-to-csv": "^1.4.0",
    "fuse.js": "^6.5.3",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "sass": "^1.105.1",
    "underscore": "^1.13.8"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"No tests configured\" && exit 0",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "consol": "rm ./src/data/consolidated_jsons/OnPrem_UC.json && python3 ./consolidation-script2/runner.py ./consolidation-script2/config/configOnPrem_UC.yaml",
    "consol_deploy_true": "rm -rf ./src/data/consolidated_jsons/* && python3 ./consolidation-script2/run_all.py ./consolidation-script2/config && gh-pages -d build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.1.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "vite": "^6.3.5"
  }
}
